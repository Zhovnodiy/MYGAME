  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0428\u0430\u043D\u043E\u0432\u043D\u0430 \u0441\u043F\u0456\u043B\u044C\u043D\u043E\u0442\u043E,\n\n\u041D\u0430\u0448\u0456
    \u043F\u043E\u0441\u043B\u0443\u0433\u0438 \u043D\u0435 \u0431\u0443\u0434\u0443\u0442\u044C
    \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0456 \u043F\u0440\u043E\u0442\u044F\u0433\u043E\u043C
    \u043D\u0430\u0441\u0442\u0443\u043F\u043D\u0438\u0445 2 \u0433\u043E\u0434\u0438\u043D
    \u0447\u0435\u0440\u0435\u0437 \u0437\u0430\u043F\u043B\u0430\u043D\u043E\u0432\u0430\u043D\u0435
    \u0449\u043E\u0442\u0438\u0436\u043D\u0435\u0432\u0435 \u043E\u0431\u0441\u043B\u0443\u0433\u043E\u0432\u0443\u0432\u0430\u043D\u043D\u044F.
    \u0412\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u043E\u0447\u0456\u043A\u0443\u0432\u0430\u0442\u0438,
    \u0449\u043E \u0441\u0435\u0440\u0432\u0435\u0440 \u0437\u0430\u043F\u0440\u0430\u0446\u044E\u0454
    \u043E 11:30.\n\n\u041F\u043E\u043A\u0438 \u0432\u0438 \u0447\u0435\u043A\u0430\u0454\u0442\u0435,
    \u0431\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u0437\u0430\u0432\u0456\u0442\u0430\u0439\u0442\u0435
    \u0434\u043E \u043D\u0430\u0448\u043E\u0433\u043E \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0443,
    \u043D\u0430\u0442\u0438\u0441\u043D\u0443\u0432\u0448\u0438 \u043A\u043D\u043E\u043F\u043A\u0443
    \u043D\u0438\u0436\u0447\u0435. \u042F\u043A\u0449\u043E \u0432\u0430\u0441 \u0446\u0456\u043A\u0430\u0432\u043B\u044F\u0442\u044C
    \u0434\u0435\u0442\u0430\u043B\u0456 \u0449\u043E\u0434\u043E \u043E\u0431\u0441\u043B\u0443\u0433\u043E\u0432\u0443\u0432\u0430\u043D\u043D\u044F,
    \u043D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C \u043A\u043D\u043E\u043F\u043A\u0443
    \"\u0434\u043E\u043A\u043B\u0430\u0434\u043D\u0456\u0448\u0435\"."
